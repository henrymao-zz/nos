# Broadcom SAI modules
MPATH       := $($(BRCM_SWITCHDEV)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) platform/broadcom/switchdev.mk platform/broadcom/switchdev.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(MPATH))

$(BRCM_SWITCHDEV)_CACHE_MODE  := GIT_CONTENT_SHA 
$(BRCM_SWITCHDEV)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(BRCM_SWITCHDEV)_DEP_FILES   := $(DEP_FILES)
